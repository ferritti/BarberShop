            <Label prefHeight="40.0" prefWidth="274.0" text="Sign in">
               <font>
                  <Font name="Helvetica Bold" size="33.0" />
               </font>
            </Label>
            <HBox prefHeight="20.0" prefWidth="274.0">
               <VBox.margin>
