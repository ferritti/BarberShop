               <children>
                  <HBox alignment="CENTER" prefHeight="42.0" prefWidth="51.0" />
                  <MFXTextField fx:id="emailField" floatMode="BORDER" prefHeight="39.0" prefWidth="323.0" promptText="Email" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="336.0">
               <children>
                  <MFXPasswordField fx:id="passwordField" floatMode="BORDER" prefHeight="39.0" prefWidth="283.0" promptText="Password" />
